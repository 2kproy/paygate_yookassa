# ── Сеть ────────────────────────────────────────────────────────────────────
PORT=8790
HOST=0.0.0.0
# Публичный адрес ЭТОГО сервиса (куда ЮKassa шлёт вебхук и возвращает юзера).
# Тот же домен, что у сайта-агрегатора; пути разведены (см. Caddyfile.snippet).
PUBLIC_URL=https://your-aggregator-domain.example

# ── Хранилище ────────────────────────────────────────────────────────────────
# Файл SQLite (токены редиректа + очередь доставки вебхуков). Смонтировать как volume.
DB_PATH=/data/paygate.db

# ── Касса агрегатора (ЮKassa) ───────────────────────────────────────────────
# Ключ живёт ТОЛЬКО здесь. Суб-мерчант его не держит.
YOOKASSA_API_BASE=https://api.yookassa.ru
YOOKASSA_SHOP_ID=000000
YOOKASSA_SECRET_KEY=live_xxxxxxxxxxxxxxxxxxxxxxxxx
# Сети, с которых ЮKassa шлёт вебхуки (allowlist). Дефолт — из документации ЮKassa.
YOOKASSA_WEBHOOK_IPS=185.71.76.0/27,185.71.77.0/27,77.75.153.0/25,77.75.156.11/32,77.75.156.35/32,77.75.154.128/25,2a02:5180::/32
# Путь, на который в кабинете ЮKassa настроен вебхук (относительно PUBLIC_URL).
WEBHOOK_PATH=/bff/v1/billing/webhook/yookassa

# ── Вход от суб-мерчанта (суб-мерчант → paygate) ────────────────────────────
# HMAC-секрет, которым суб-мерчант подписывает запросы создания/статуса/рефанда.
INGRESS_SECRET=change-me-shared-secret-ingress
# Разрешённые IP серверов суб-мерчанта (CIDR через запятую). Пусто = проверка
# выключена (НЕ рекомендуется в проде).
INGRESS_ALLOWED_IPS=

# ── Форвард вебхуков на суб-мерчанта (paygate → суб-мерчант) ────────────────
# Полный URL вебхук-эндпоинта суб-мерчанта, куда пересылаем сырое тело ЮKassa.
FORWARD_URL=https://api.your-submerchant.example/webhook/yookassa
# HMAC-секрет, которым paygate подписывает форвард (суб-мерчант проверяет).
FORWARD_SECRET=change-me-shared-secret-forward
# Максимум попыток доставки, дальше — dead-letter (алерт/сверка).
RELAY_MAX_ATTEMPTS=12

# ── Редирект возврата после оплаты ──────────────────────────────────────────
# Путь, на который ЮKassa возвращает юзера (мы отдаём 302 на origin суб-мерчанта
# либо заглушку).
RETURN_PATH=/pay/return
# Куда РАЗРЕШЕНО редиректить (origin'ы суб-мерчанта, через запятую). Анти-open-
# redirect. Должен включать ВСЕ домены возврата суб-мерчанта.
ALLOWED_RETURN_ORIGINS=https://app.your-submerchant.example,https://t.me
# Жизнь токена редиректа (сек). Привязана к жизни платежа ЮKassa (~1 час).
REDIRECT_TTL_SECONDS=3600
# После успеха токен живёт ещё столько (сек), затем — заглушка.
SUCCESS_TTL_SECONDS=180
