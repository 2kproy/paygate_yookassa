# ─────────────────────────────────────────────────────────────────────────────
# Врезка в существующий блок сайта-агрегатора (домен агрегатора и www-вариант).
# ВСТАВИТЬ ЭТИ ДИРЕКТИВЫ ПЕРВЫМИ внутри блока — до handle сайта/лендинга,
# т.к. Caddy выбирает первый подходящий handle.
#
# Пути специально разведены с маршрутами сайта-агрегатора — конфликтов быть не
# должно (подберите префиксы под свой сайт, если /bff|/agg|/pay уже заняты):
#   /bff/*  — вебхук ЮKassa (/bff/v1/billing/webhook/yookassa) + внутренние
#   /agg/*  — приём запросов от суб-мерчанта: создание/статус/рефанд
#   /pay/*  — возврат пользователя после оплаты (302 на origin или заглушка)
# ─────────────────────────────────────────────────────────────────────────────

	@paygate path /bff/* /agg/* /pay/*
	handle @paygate {
		reverse_proxy paygate:8790 {
			# КРИТИЧНО для IP-allowlist: ставим доверенный IP реального клиента.
			# Клиент не может его перезаписать (Caddy выставляет {remote_host}).
			header_up X-Real-IP {remote_host}
		}
	}
